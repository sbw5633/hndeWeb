{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Chrome, dev + env files)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "cwd": "${workspaceFolder}",
      "toolArgs": [
        "--dart-define=FIREBASE_ENV=dev",
        "--dart-define=FIRESTORE_APP_ID=hnde-work-dev",
        "--dart-define-from-file=env.worker",
        "--dart-define-from-file=env.tour",
        "--dart-define-from-file=env.kakao",
        "--web-port=5000"
      ]
    },
    {
      "name": "Flutter Web (Chrome, prod + env files)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "cwd": "${workspaceFolder}",
      "toolArgs": [
        "--dart-define=FIREBASE_ENV=prod",
        "--dart-define=FIRESTORE_APP_ID=hnde-work-web",
        "--dart-define-from-file=env.worker",
        "--dart-define-from-file=env.tour",
        "--dart-define-from-file=env.kakao",
        "--web-port=5000"
      ]
    }
  ]
}
